# ==============================================================================
# Crowdfunding-Back — الگوی متغیرهای محیطی (بدون هرگونه راز واقعی)
# در محیط عملیاتی سی‌پنل نایترو یا کانتینر، مقادیر واقعی را جایگزین کنید.
# ==============================================================================

# ── تنظیمات هسته جنگو ────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=false
APP_VERSION=1.1.0
DJANGO_SECRET_KEY=replace-with-at-least-64-random-cryptographic-characters-in-prod-0123456789
DJANGO_ALLOWED_HOSTS=api.charity.example.org,charity.example.org
DJANGO_SECURE_SSL_REDIRECT=true

# مسیر تصادفی‌شده پنل ادمین جنگو + فهرست سفید اختیاری IPهای مجاز مدیریت
DJANGO_ADMIN_URL_PATH=ops-console-change-me/
DJANGO_ADMIN_ALLOWED_IPS=

# ── کلیدهای مستقل رمزنگاری فیلدها، شاخص کور و لنگر زنجیره ممیزی ────────────
# هشدار: در محیط تولید هر سه کلید باید مقادیر تصادفی مستقل حداقل ۳۲ کاراکتری باشند.
FIELD_ENCRYPTION_KEY=replace-with-32plus-random-chars-for-aes-fernet-field-encryption
PII_BLIND_INDEX_KEY=replace-with-32plus-random-chars-for-hmac-pii-blind-index
AUDIT_ANCHOR_HMAC_KEY=replace-with-32plus-random-chars-for-audit-chain-hmac-anchor

# ── پایگاه‌داده MariaDB / MySQL (همراه با کش اتمیک مبتنی بر جدول) ───────────
DATABASE_URL=mysql://cf_db_user:replace_db_password@127.0.0.1:3306/cf_production_db

# ── تنظیمات CORS، CSRF و احراز هویت دوگانه (Cookie + JWT) ───────────────────
PUBLIC_APP_BASE_URL=https://charity.example.org
# آدرسی که در فیلد servers قرارداد OpenAPI و کلاینت فرانتاند استفاده میشود
PUBLIC_API_BASE_URL=https://api.charity.example.org
CORS_ALLOWED_ORIGINS=https://charity.example.org
CSRF_TRUSTED_ORIGINS=https://charity.example.org,https://api.charity.example.org
AUTH_SESSION_COOKIE_NAME=cf_session
# Lax برای همدامنه/زیردامنه؛ None فقط وقتی فرانتاند دامنهای کاملاً متفاوت دارد (حتماً HTTPS)
DJANGO_SESSION_COOKIE_SAMESITE=Lax
# تعداد پراکسیهای معتمد پیش از برنامه برای استخراج امن IP (محدودسازی نرخ و ممیزی)
TRUSTED_PROXY_COUNT=0
# نشانی لنگرهای کدهای خطا در فیلد type پاسخهای RFC 9457
PROBLEM_TYPE_URI_TEMPLATE=https://github.com/mohebbibrothers/Crowdfunding-Back/blob/main/docs/frontend/ERRORS.md#error-{code}
# در تولید مستندات Swagger/ReDoc پشت نشست کارکنان محافظت میشوند
API_DOCS_ALLOW_ANONYMOUS=false
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
MFA_STEP_UP_TTL_SECONDS=600

# نرخ‌های محدودسازی درخواست (Throttling)
THROTTLE_ANON_PUBLIC=120/min
THROTTLE_CHECKOUT=30/min
THROTTLE_OTP_REQUEST=10/min
THROTTLE_OTP_VERIFY=15/min
THROTTLE_MFA_VERIFY=10/min

# ── درگاه پرداخت آنلاین (زرین‌پال نسخه ۴) ───────────────────────────────────
# در محیط توسعه می‌توانید از sandbox استفاده کنید؛ در تولید حتماً zarinpal قرار دهید.
PAYMENT_DEFAULT_GATEWAY=zarinpal
PAYMENT_CALLBACK_URL=https://api.charity.example.org/api/v1/payments/callback
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000

# ── پنل پیامک الگومحور (آماده اتصال بدون تغییر کد بک‌اند) ───────────────────
# تا زمان دریافت کلید پنل پیامک از کارفرما، SMS_ENABLED=false باقی بماند.
SMS_ENABLED=false
SMS_PROVIDER_NAME=kavenegar
SMS_API_URL=https://api.kavenegar.com/v1/REPLACE_KEY/verify/lookup.json
SMS_API_KEY=replace-when-sms-panel-is-provisioned
SMS_TIMEOUT_SECONDS=5.0
SMS_PATTERN_CODES_JSON={"otp_login":"cf-otp-login","otp_express":"cf-otp-express","receipt_issued":"cf-receipt","dedication_gift":"cf-dedication","impact_published":"cf-impact"}

# فهرست سفید دامنه‌های خروجی مجاز (محافظ SSRF)
OUTBOUND_ALLOWED_HOSTS=payment.zarinpal.com,sandbox.zarinpal.com,api.kavenegar.com,ippanel.com

# ── پایش، متریک‌ها و کنترل بار ──────────────────────────────────────────────
MAX_INFLIGHT_REQUESTS=250
METRICS_BEARER_TOKEN=replace-with-random-prometheus-scrape-token
